PORTA=8080
NOME_PLATAFORMA=Evve
AMBIENTE_APP=development
DATABASE_URL=postgres://arcadia:arcadia@localhost:5442/arcadia?sslmode=disable

FRONTEND_URL=http://localhost:5173

# Troque em produção — usado para assinar os access tokens (JWT).
JWT_SECRET=dev-secret-troque-em-producao
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DIAS=30

# Client ID OAuth do Google (console.cloud.google.com). Sem isso,
# POST /auth/google responde 503 — o resto do auth funciona normalmente.
GOOGLE_CLIENT_ID=

# Sem RESEND_API_KEY, e-mails (verificação, redefinição de senha) só são
# logados no console em vez de enviados — útil para dev sem conta Resend.
RESEND_API_KEY=
EMAIL_REMETENTE="Evve <no-reply@evve.local>"

# Uploads: por padrão ficam no banco (STORAGE_DRIVER=banco), servidos em
# /api/v1/uploads. Sem UPLOADS_BASE_URL, o link é FRONTEND_URL/api/v1/uploads.
# "disco" só para desenvolvimento; "s3" (R2/S3) quando houver muitas fotos.
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=http://localhost:8080/uploads

# URL pública da própria API — usada para montar a notification_url que o
# Mercado Pago chama (o MP precisa alcançar essa URL pela internet; em
# desenvolvimento local isso normalmente exige um túnel tipo ngrok).
BACKEND_URL=http://localhost:8080

# Mercado Pago (Checkout Pro, conta da PLATAFORMA — custódia, seção 2.3 do
# plano). Use um Access Token de TESTE (TEST-...) em desenvolvimento; nunca
# um token de produção (APP_USR-...) aqui ou em qualquer commit.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: valida a assinatura do webhook (x-signature). Sem isso, o
# webhook ainda é seguro porque sempre reconsulta o pagamento na API do MP
# em vez de confiar no corpo da notificação — mas é uma camada a menos.
MERCADOPAGO_WEBHOOK_SECRET=
# Chave pública (Credenciais de produção no painel do MP). Sem ela, o cartão
# abre no site do Mercado Pago; o Pix aparece na página de qualquer jeito.
MERCADOPAGO_PUBLIC_KEY=
# Item 9.1: chave privada Ed25519 (PEM) que assina o envio automático de Pix
# ao organizador (Mercado Pago Payouts). Gere com:
#   openssl genpkey -algorithm ed25519 -out mpprivate.pem && openssl pkey -in mpprivate.pem -pubout -out mppublic.pem
# Envie só o mppublic.pem à equipe de integrações do Mercado Pago. Aqui vai o
# conteúdo do mpprivate.pem (pode usar \n no lugar das quebras de linha).
# Vazia em produção = repasse automático desligado (segue manual).
MERCADOPAGO_PAYOUT_CHAVE_PRIVADA=

# Protege as rotas /jobs/* (seção 4: "rota protegida por X-Cron-Secret").
# Sem isso configurado, as rotas de job ficam bloqueadas (401) por padrão.
CRON_SECRET=

# --- Produção (AMBIENTE_APP=production recusa config insegura) ---
# STORAGE_DRIVER=s3        # opcional; o padrão "banco" já não some a cada deploy
# S3_ENDPOINT=<conta>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# UPLOADS_BASE_URL=https://cdn.seudominio.com   # URL pública do bucket

# Só para testes locais com um Mercado Pago falso. NUNCA defina em produção.
# MERCADOPAGO_BASE_URL=http://127.0.0.1:9099

# Item 5.5 — escala e monitoramento
# Webhook do Discord ou Slack que recebe aviso de erro 500 (opcional, recomendado em produção).
ALERTA_WEBHOOK_URL=
# Máximo de conexões com o Postgres por instância da API. Ajuste ao limite do plano do banco.
DB_MAX_CONEXOES=20

# Central de ajuda (item 9.9): e-mail que recebe as mensagens do formulário.
SUPORTE_EMAIL=

# Rascunho de evento com IA (item 10.5). Vazia: o botão de IA não aparece.
ANTHROPIC_API_KEY=
